# Database credentials — single source of truth for PLC and test postgres.
# Consumer overrides these to use their own postgres instance.
DEVNET_DB_USER=postgres
DEVNET_DB_PASSWORD=postgres
DEVNET_DB_HOST=postgres
DEVNET_DB_PORT=5432
DEVNET_DB_NAME=plc

# Required: SMTP server for PDS email verification
# Consumer provides this — must be reachable from Docker network
DEVNET_SMTP_URL=smtp://maildev:1025

# Optional: Override defaults
# DEVNET_PDS_HOSTNAME=devnet.test
# DEVNET_PDS_ADMIN_PASSWORD=devnet-admin-password
# DEVNET_HANDLE_DOMAIN=.devnet.test
# DEVNET_SEED_ACCOUNTS=true

# Host ports — override to avoid conflicts with other local services
# DEVNET_PDS_PORT=3000
# DEVNET_PLC_PORT=2582
# DEVNET_JETSTREAM_PORT=6008
# DEVNET_JETSTREAM_METRICS_PORT=6009
# DEVNET_TAP_PORT=2480
