# Database credentials — single source of truth for PLC and test postgres.
# Consumer overrides these to use their own postgres instance.
SG_DB_USER=postgres
# SG_DB_PASSWORD=   (unset: snowglobe up makes a random one, in secrets.env in the snowglobe's state folder)
SG_DB_HOST=postgres
SG_DB_PORT=5432
SG_DB_NAME=plc

# Required: SMTP server for PDS email verification
# Consumer provides this — must be reachable from Docker network
SG_SMTP_URL=smtp://maildev:1025

# Optional: Override defaults
# The snowglobe's domain: its PDSes are <name>.<domain>. A domain under .test, .local or
# .localhost fails sign-in (a PDS refuses an OAuth client there); this default is ours and
# resolves to this machine.
# SG_DOMAIN=local.snowglobe.at
# SG_PDS_HOSTNAME=local.snowglobe.at
# SG_PDS_ADMIN_PASSWORD=   # unset: up makes a random one and keeps it in the snowglobe's admin.env
# SG_HANDLE_DOMAIN=.local.snowglobe.at
# SG_SEED_ACCOUNTS=true

# Host ports — override to avoid conflicts with other local services
# SG_PDS_PORT=3000
# SG_PLC_PORT=2582
# SG_JETSTREAM_PORT=6008
# SG_JETSTREAM_METRICS_PORT=6009
# SG_TAP_PORT=2480
