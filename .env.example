# Database credentials — single source of truth for PLC and test postgres.
# Consumer overrides these to use their own postgres instance.
SG_DB_USER=postgres
SG_DB_PASSWORD=postgres
SG_DB_HOST=postgres
SG_DB_PORT=5432
SG_DB_NAME=plc

# Required: SMTP server for PDS email verification
# Consumer provides this — must be reachable from Docker network
SG_SMTP_URL=smtp://maildev:1025

# Optional: Override defaults
# The https devnet's domain: its PDSes are alpha.<domain>, regular.<domain> and
# prod.<domain>, and the alpha's handles <name>.<domain>. The plain stack uses
# SG_PDS_HOSTNAME and SG_HANDLE_DOMAIN instead.
# SG_DOMAIN=devnet.test
# SG_PDS_HOSTNAME=devnet.test
# SG_PDS_ADMIN_PASSWORD=devnet-admin-password
# SG_HANDLE_DOMAIN=.devnet.test
# SG_SEED_ACCOUNTS=true

# Host ports — override to avoid conflicts with other local services
# SG_PDS_PORT=3000
# SG_PLC_PORT=2582
# SG_JETSTREAM_PORT=6008
# SG_JETSTREAM_METRICS_PORT=6009
# SG_TAP_PORT=2480
