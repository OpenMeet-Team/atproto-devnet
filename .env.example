# Required: PostgreSQL connection for PLC server
# Consumer provides this — must be reachable from Docker network
DEVNET_PLC_DB_URL=postgres://postgres:postgres@postgres:5432/plc

# Required: SMTP server for PDS email verification
# Consumer provides this — must be reachable from Docker network
DEVNET_SMTP_URL=smtp://maildev:1025

# Optional: Override defaults
# DEVNET_PDS_HOSTNAME=devnet.test
# DEVNET_PDS_ADMIN_PASSWORD=devnet-admin-password
# DEVNET_HANDLE_DOMAIN=.devnet.test
# DEVNET_SEED_ACCOUNTS=true
