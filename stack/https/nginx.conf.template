# nginx for the https snowglobe (the globe's compose.yml, bin/snowglobe.mjs render). One leaf
# certificate names every host below; data/https/ca.crt is the CA that signed it (bin/snowglobe.mjs certs).
# A template: at start the image writes it to conf.d/default.conf with the SG_DOMAIN
# setting filled in, so this is the http block's whole server list. The comments below
# name its default, local.snowglobe.at.

# Docker's embedded DNS, re-asked every 10 s, so a recreated container's new
# address is picked up without reloading nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

ssl_certificate     /etc/nginx/https/leaf.crt;
ssl_certificate_key /etc/nginx/https/leaf.key;
ssl_protocols       TLSv1.2 TLSv1.3;

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
# Firehose and event-stream websockets stay open.
proxy_read_timeout 1h;
proxy_send_timeout 1h;
# Blob uploads.
client_max_body_size 100m;

# A name this file does not list gets no certificate at all.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# Each PDS and its handles, and the relay, the feed, Slingshot and PDSls, at their names under
# the domain: rendered from snowglobe.yml by bin/snowglobe.mjs render into the globe's nginx/
# folder (data/globe/nginx/globe.conf), mounted at /etc/nginx/globe/. Each PDS is its own
# service, pds-<name>:3000. A PDS answers /.well-known/atproto-did by Host, which the http block
# passes through as sent. An app's handle ending (below) wins over a PDS's *.<domain> as the
# longer wildcard.
include /etc/nginx/globe/*.conf;

# The directory at an https name under the domain, as a hosted globe has it (plc.<globe>), so an
# app's browser code, which cannot use plain http or the host's ports, reaches it too.
server {
    listen 443 ssl;
    server_name plc.${SG_DOMAIN};
    location / {
        set $plc http://plc:2582;
        proxy_pass $plc;
    }
}

# The network's own page at the bare name, as a globe serves it at <globe>.snowglobe.at: the same
# page/index.html, with this stack's relays (page/snowglobe.conf) and a snowglobe.json naming its
# services, which bin/snowglobe.mjs up and snowglobe app write.
server {
    listen 443 ssl;
    server_name ${SG_DOMAIN};
    server_tokens off;
    root /srv/page;
    include /etc/nginx/page/snowglobe.conf;
}

# This stack's PLC, standing in for the real directory.
server {
    listen 443 ssl;
    server_name plc.directory;
    location / {
        set $plc http://plc:2582;
        proxy_pass $plc;
    }
}

# Apps on this machine: https://<name>.app.${SG_DOMAIN} goes to the port that
# bin/snowglobe.mjs app recorded for <name> (data/https/apps). It writes, into
# data/https/nginx/ (mounted at /etc/nginx/snowglobe/), one upstream per app, naming
# host.docker.internal, and one map line per name. An upstream's name is resolved
# once, when nginx loads it, through the container's hosts file (extra_hosts), which
# Docker's DNS does not serve. Neither file has to exist. An app that claimed a handle
# ending (bin/snowglobe.mjs app <name> <port> <ending>) also gets a server there for
# *.<ending>.local.snowglobe.at, which wins over a PDS's *.local.snowglobe.at as the
# longer wildcard.
include /etc/nginx/snowglobe/*.conf;

map $host $snowglobe_app {
    default "";
    include /etc/nginx/snowglobe/*.map;
}

# A name no app registered gets a 404 from nginx itself and reaches nothing.
server {
    listen 443 ssl;
    server_name *.app.${SG_DOMAIN};
    if ($snowglobe_app = "") {
        return 404 "No app is registered at $host (snowglobe app).\n";
    }
    location / {
        proxy_pass http://$snowglobe_app;
    }
}
