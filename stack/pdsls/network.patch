diff --git a/src/lib/network.ts b/src/lib/network.ts
new file mode 100644
index 0000000..cc75ea4
--- /dev/null
+++ b/src/lib/network.ts
@@ -0,0 +1,37 @@
+// The atproto network PDSls looks at. A host page can point it at a private network (a snowglobe, a
+// sandbox) by setting globalThis.PDSLS_NETWORK before the app loads; unset, every address is the
+// public network's, as before. A setting given as null turns its feature off, for a network that
+// has no such service, so nothing falls back to a public one.
+type NetworkSettings = {
+  /** Default PLC directory (a visitor can still change it in settings). */
+  plcDirectory?: string;
+  /** DNS-over-HTTPS resolver for handles and lexicon authorities; null: no DNS lookups. */
+  dohUrl?: string | null;
+  /** A DID that answers for every NSID, for a network whose lexicons have no DNS. */
+  lexiconAuthority?: string;
+  /** Bluesky API for actor search and avatars; null: off. */
+  appviewUrl?: string | null;
+  /** Constellation, for backlinks; null: off. */
+  constellationUrl?: string | null;
+  /** Default stream instances; null: that stream is off. */
+  jetstreamUrl?: string | null;
+  firehoseUrl?: string | null;
+  spacedustUrl?: string | null;
+  /** Sign in with a client whose metadata is at this page's own origin. */
+  oauthAtOrigin?: boolean;
+};
+
+const given: NetworkSettings = (globalThis as { PDSLS_NETWORK?: NetworkSettings }).PDSLS_NETWORK ?? {};
+const pick = <T>(value: T | undefined, fallback: T): T => (value === undefined ? fallback : value);
+
+export const network = {
+  plcDirectory: given.plcDirectory ?? "https://plc.directory",
+  dohUrl: pick(given.dohUrl, "https://dns.google/resolve?"),
+  lexiconAuthority: given.lexiconAuthority,
+  appviewUrl: pick(given.appviewUrl, "https://public.api.bsky.app"),
+  constellationUrl: pick(given.constellationUrl, "https://constellation.microcosm.blue"),
+  jetstreamUrl: pick(given.jetstreamUrl, "wss://jetstream1.us-east.bsky.network/subscribe"),
+  firehoseUrl: pick(given.firehoseUrl, "wss://bsky.network"),
+  spacedustUrl: pick(given.spacedustUrl, "wss://spacedust.microcosm.blue/subscribe"),
+  oauthAtOrigin: given.oauthAtOrigin === true,
+};
