#!/bin/sh
set -eu

# Run a command as if the https devnet were the real network, for that command's
# process tree only:
#   - the three PDS names (alpha.devnet.test, regular.devnet.test, prod.devnet.test),
#     plc.directory, every handle in data/https/names (scripts/https-account.sh and
#     https-up.sh add them) and every app in data/https/apps, as <name>.devnet.internal
#     (scripts/https-app.sh), resolve to 127.0.0.1, where nginx answers on 443;
#   - Node trusts the devnet CA (NODE_EXTRA_CA_CERTS=data/https/ca.crt), on top of
#     its own roots. Miniflare's source passes the same file on to workerd.
#
# Usage: scripts/https-run <cmd> [args...]
#   e.g. scripts/https-run node scripts/https-probe.mjs
#        (cd ../myapp && ../atproto-devnet/scripts/https-run npm run dev)
#
# How: bubblewrap gives the command its own mount namespace with a generated hosts
# file bound over /etc/hosts. Nothing else changes: same filesystem, same network,
# same user. Outside, every name resolves as usual. HTTPS_RUN_EXTRA_NAMES adds
# names (space-separated). The names are read when the command starts, so a handle
# or app added later needs a restart of the command.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DATA="$(cd "${SCRIPT_DIR}/.." && pwd)/data/https"
CA="${DATA}/ca.crt"

if [ $# -eq 0 ]; then
  echo "Usage: scripts/https-run <cmd> [args...]" >&2
  exit 2
fi
if [ ! -f "${CA}" ]; then
  echo "https-run: no ${CA}; run scripts/https-ca.sh (or scripts/https-up.sh) first" >&2
  exit 1
fi
if ! command -v bwrap >/dev/null 2>&1; then
  echo "https-run: bwrap (bubblewrap) is not installed" >&2
  exit 1
fi

NAMES="alpha.devnet.test regular.devnet.test prod.devnet.test plc.directory"
if [ -f "${DATA}/names" ]; then
  NAMES="${NAMES} $(grep -E '^[A-Za-z0-9.-]+$' "${DATA}/names" | tr '\n' ' ')"
fi
if [ -f "${DATA}/apps" ]; then
  NAMES="${NAMES} $(awk 'NF == 2 { printf "%s.devnet.internal ", $1 }' "${DATA}/apps")"
fi
NAMES="${NAMES} ${HTTPS_RUN_EXTRA_NAMES:-}"

# The real hosts file, minus any line naming one of ours, plus ours on 127.0.0.1.
# Written aside and renamed, so a run already holding the old file is undisturbed.
HOSTS="${DATA}/hosts"
TMP="$(mktemp "${DATA}/hosts.XXXXXX")"
{
  awk -v names="${NAMES}" '
    BEGIN { n = split(names, a, " "); for (i = 1; i <= n; i++) ours[a[i]] = 1 }
    { keep = 1; for (i = 2; i <= NF; i++) if ($i in ours) keep = 0; if (keep) print }
  ' /etc/hosts
  echo "# https devnet (scripts/https-run)"
  set -f
  printf '%s\n' ${NAMES} | awk 'NF && !seen[$0]++ { print "127.0.0.1 " $0 }'
  set +f
} > "${TMP}"
chmod 644 "${TMP}"
mv "${TMP}" "${HOSTS}"

export NODE_EXTRA_CA_CERTS="${CA}"
exec bwrap --dev-bind / / --ro-bind "${HOSTS}" /etc/hosts --die-with-parent -- "$@"
