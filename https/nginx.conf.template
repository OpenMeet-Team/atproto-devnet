# nginx for the https devnet (docker-compose.https.yml). One leaf certificate names
# every host below; data/https/ca.crt is the CA that signed it (scripts/https-ca.sh).
# A template: at start the image writes it to conf.d/default.conf with the DEVNET_DOMAIN
# setting filled in, so this is the http block's whole server list. The comments below
# name its default, devnet.test.

# Docker's embedded DNS, re-asked every 10 s, so a recreated container's new
# address is picked up without reloading nginx.
resolver 127.0.0.11 valid=10s ipv6=off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

ssl_certificate     /etc/nginx/https/leaf.crt;
ssl_certificate_key /etc/nginx/https/leaf.key;
ssl_protocols       TLSv1.2 TLSv1.3;

proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto https;
proxy_set_header Upgrade $http_upgrade;
proxy_set_header Connection $connection_upgrade;
# Firehose and event-stream websockets stay open.
proxy_read_timeout 1h;
proxy_send_timeout 1h;
# Blob uploads.
client_max_body_size 100m;

# A name this file does not list gets no certificate at all.
server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# Each PDS, and every handle under its service domain: a PDS answers
# /.well-known/atproto-did by Host, so Host is passed through as sent. The two extra
# PDSes share the alpha's network namespace, so all three are reached as pds:<port>.
# Of two matching wildcards nginx takes the longer, so *.regular.devnet.test wins over
# *.devnet.test.
server {
    listen 443 ssl;
    server_name alpha.${DEVNET_DOMAIN} *.${DEVNET_DOMAIN};
    location / {
        set $pds http://pds:3010;
        proxy_pass $pds;
    }
}

server {
    listen 443 ssl;
    server_name regular.${DEVNET_DOMAIN} *.regular.${DEVNET_DOMAIN};
    location / {
        set $pds http://pds:3020;
        proxy_pass $pds;
    }
}

server {
    listen 443 ssl;
    server_name prod.${DEVNET_DOMAIN} *.prod.${DEVNET_DOMAIN};
    location / {
        set $pds http://pds:3030;
        proxy_pass $pds;
    }
}

# Slingshot shares slingshot-dns's network namespace (docker-compose.https.yml). An exact
# name beats the alpha's *.${DEVNET_DOMAIN} wildcard, so "slingshot" is not a handle.
server {
    listen 443 ssl;
    server_name slingshot.${DEVNET_DOMAIN};
    location / {
        set $slingshot http://slingshot-dns:8080;
        proxy_pass $slingshot;
    }
}

# This stack's PLC, standing in for the real directory.
server {
    listen 443 ssl;
    server_name plc.directory;
    location / {
        set $plc http://plc:2582;
        proxy_pass $plc;
    }
}

# Apps on this machine: https://<name>.devnet.internal goes to the port that
# scripts/https-app.sh recorded for <name> (data/https/apps). That script writes, into
# data/https/nginx/ (mounted at /etc/nginx/devnet/), one upstream per app, naming
# host.docker.internal, and one map line per name. An upstream's name is resolved
# once, when nginx loads it, through the container's hosts file (extra_hosts), which
# Docker's DNS does not serve. Neither file has to exist. An app that claimed a handle
# ending (scripts/https-app.sh <name> <port> <ending>) also gets a server there for
# *.<ending>.devnet.test, which wins over the alpha's *.devnet.test as the longer wildcard.
include /etc/nginx/devnet/*.conf;

map $host $devnet_app {
    default "";
    include /etc/nginx/devnet/*.map;
}

# A name no app registered gets a 404 from nginx itself and reaches nothing.
server {
    listen 443 ssl;
    server_name *.devnet.internal;
    if ($devnet_app = "") {
        return 404 "No app is registered at $host (scripts/https-app.sh).\n";
    }
    location / {
        proxy_pass http://$devnet_app;
    }
}
